---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../components/StaticIcon.astro';
import { getSupabaseAdmin, hasSupabaseConfig } from '../../lib/server/supabaseAdmin';

import blog1 from '../../assets/grid-1.webp';
import blog2 from '../../assets/grid-2.webp';
import blog3 from '../../assets/grid-3.webp';
import blog4 from '../../assets/grid-4.webp';

const fallbackImages = [blog1, blog2, blog3, blog4];

let blogs = [];

if (hasSupabaseConfig()) {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('blogs')
    .select('*')
    .eq('published', true)
    .order('created_at', { ascending: false });

  if (!error && data) {
    blogs = data.map((blog) => ({
      id: blog.slug,
      imageUrl: blog.image_url,
      data: {
        title: blog.title,
        excerpt: blog.excerpt || '',
        author: blog.author || 'BuildPRO Team',
        date: blog.created_at,
        tags: blog.tags || [],
      },
    }));
  }
}

if (!hasSupabaseConfig()) {
  const allBlogs = await getCollection('blog');
  blogs = allBlogs
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .map((blog, index) => ({
      id: blog.id,
      imageUrl: fallbackImages[index % fallbackImages.length].src,
      data: blog.data,
    }));
}

function formatDate(date) {
  if (!date) return 'Recently';
  return new Date(date).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Layout
  title="Blog & Insights | BuildPRO"
  description="Stay up to date with the latest trends in interior design, home renovation, and smart spacing solutions from the BuildPRO team."
  navVariant="solid"
>
  <main id="main-content" class="min-h-screen bg-[#fafafa] pt-24">
    <section class="relative overflow-hidden bg-gray-950 px-5 py-16 text-white sm:px-6 md:px-12 lg:px-24">
      <div class="relative z-10 mx-auto max-w-4xl">
        <nav class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">
          <a href="/" class="transition hover:text-white">Home</a>
          <span class="text-white/30">/</span>
          <span class="text-white/60">Blog</span>
        </nav>
        <h1 class="text-4xl font-bold leading-tight md:text-5xl">Blog & Insights</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-400 md:text-base">
          Design inspiration, renovation guides, and stories from our studio for your next project.
        </p>
      </div>
    </section>

    <section class="section-pad container-site">
      {blogs.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-8 py-20 text-center">
          <Icon name="mdi:newspaper-variant-outline" size={48} class="mx-auto text-amber-400" />
          <p class="mt-4 text-lg font-semibold text-gray-900">No posts yet</p>
          <p class="mt-2 text-sm text-gray-500">Check back soon for new articles.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {blogs.map((blog, index) => {
            const imageSrc = blog.imageUrl || fallbackImages[index % fallbackImages.length].src;
            const tag = blog.data.tags?.[0] || 'Interior Design';

            return (
              <article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg transition duration-500 hover:-translate-y-2 hover:border-amber-200/50 hover:shadow-2xl">
                <a href={`/blog/${blog.id}`} class="relative block overflow-hidden">
                  <img
                    src={imageSrc}
                    alt={blog.data.title}
                    loading="lazy"
                    class="h-64 w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                  <span class="absolute left-5 top-5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-gray-800">
                    {tag}
                  </span>
                  <span class="absolute bottom-5 right-5 flex h-11 w-11 items-center justify-center rounded-full bg-amber-400 text-gray-900 opacity-0 shadow-lg transition duration-500 group-hover:opacity-100">
                    <Icon name="mdi:arrow-top-right" size={20} class="text-current" />
                  </span>
                </a>

                <div class="flex flex-1 flex-col p-7">
                  <div class="flex flex-wrap gap-4 text-xs text-gray-400">
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="mdi:account-outline" size={14} class="text-amber-400" />
                      {blog.data.author}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="mdi:clock-outline" size={14} class="text-amber-400" />
                      {formatDate(blog.data.date)}
                    </span>
                  </div>

                  <h2 class="mt-4 text-xl font-bold leading-snug text-gray-900 transition group-hover:text-amber-500">
                    <a href={`/blog/${blog.id}`}>{blog.data.title}</a>
                  </h2>

                  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-gray-500">
                    {blog.data.excerpt}
                  </p>

                  <a
                    href={`/blog/${blog.id}`}
                    class="mt-6 inline-flex items-center gap-2 border-t border-gray-100 pt-5 text-sm font-semibold text-gray-900 transition hover:text-amber-500"
                  >
                    Read full article
                    <Icon name="mdi:arrow-right" size={18} class="text-amber-500" />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>
  </main>
</Layout>
