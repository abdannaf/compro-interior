---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

import blog1 from '../../assets/grid-1.png';
import blog2 from '../../assets/grid-2.png';
import blog3 from '../../assets/grid-3.png';
import blog4 from '../../assets/grid-4.png';

const fallbackImages = [blog1, blog2, blog3, blog4];

const allBlogs: CollectionEntry<'blog'>[] = await getCollection('blog');
// Sort by date descending
const blogs = allBlogs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Blog & Insights | BuildPRO" description="Stay up to date with the latest trends in interior design, home renovation, and smart spacing solutions from the BuildPRO team." navVariant="solid">
    <main class="pt-24 min-h-screen bg-white">
        <!-- Hero/Header Section -->
        <section class="bg-gray-900 text-white py-16 px-6 md:px-20 lg:px-24">
            <div class="max-w-4xl">
                <nav class="flex gap-2 text-xs uppercase tracking-wider text-amber-400 mb-4">
                    <a href="/" class="hover:underline">Home</a>
                    <span>/</span>
                    <span class="text-white/60">Blog</span>
                </nav>
                <h1 class="text-4xl md:text-5xl font-bold uppercase tracking-tight">Our Blog & Insights</h1>
                <p class="text-gray-400 text-sm md:text-base mt-4 max-w-2xl leading-relaxed">
                    Explore design inspiration, practical guides, renovation tips, and behind-the-scenes stories from our expert architects and designers.
                </p>
            </div>
        </section>

        <!-- Blog Grid Section -->
        <section class="py-16 px-6 md:px-20 lg:px-24 max-w-7xl mx-auto">
            {blogs.length === 0 ? (
                <div class="text-center py-20 text-gray-500">
                    <Icon name="mdi:file-document-outline" size={48} class="mx-auto text-gray-300 mb-4" />
                    <p class="text-lg">No blog posts found. Check back later!</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {blogs.map((blog, index) => {
                        const imageSrc = fallbackImages[index % fallbackImages.length].src;
                        return (
                            <a href={`/blog/${blog.id}`} class="flex flex-col bg-gray-50 border border-gray-100 rounded-sm overflow-hidden group hover:shadow-md transition-all duration-300">
                                <!-- Image -->
                                <div class="overflow-hidden relative h-56">
                                    <img
                                        src={imageSrc}
                                        alt={blog.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                                    />
                                    {blog.data.tags && blog.data.tags.length > 0 && (
                                        <span class="absolute top-4 left-4 bg-amber-400 text-gray-900 text-xs font-semibold px-3 py-1 uppercase tracking-wider rounded-sm">
                                            {blog.data.tags[0]}
                                        </span>
                                    )}
                                </div>

                                <!-- Content -->
                                <div class="p-6 flex flex-col gap-4 flex-1">
                                    <!-- Meta Info -->
                                    <div class="flex flex-wrap gap-4 text-gray-400 text-xs">
                                        <span class="flex items-center gap-1">
                                            <Icon name="mdi:account-outline" size={14} class="text-amber-400"/>
                                            By {blog.data.author}
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <Icon name="mdi:clock-outline" size={14} class="text-amber-400"/>
                                            {new Date(blog.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                        </span>
                                    </div>

                                    <!-- Title -->
                                    <h2 class="font-bold text-gray-900 text-lg leading-snug group-hover:text-amber-400 transition duration-300">
                                        {blog.data.title}
                                    </h2>

                                    <!-- Excerpt -->
                                    <p class="text-gray-500 text-sm leading-relaxed line-clamp-3">
                                        {blog.data.excerpt}
                                    </p>

                                    <!-- Action link -->
                                    <span class="text-sm text-gray-700 hover:text-amber-400 transition duration-300 mt-auto font-medium flex items-center gap-1">
                                        Read Full Article <Icon name="mdi:chevron-right" size={16} />
                                    </span>
                                </div>
                            </a>
                        );
                    })}
                </div>
            )}
        </section>
    </main>
</Layout>
