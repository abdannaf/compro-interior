---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

import service1 from '../../assets/grid-2.png';
import service2 from '../../assets/grid-3.png';
import service3 from '../../assets/grid-1.png';

const services = [
  {
    icon: 'mdi:floor-plan',
    title: 'Interior Design',
    desc: 'We create beautiful, functional spaces tailored to your lifestyle. Our designers combine space planning, color schemes, lighting layouts, and material sourcing to design your dream interiors.',
    details: [
      'Comprehensive 2D & 3D space layouts',
      'Color consultation & material mood boards',
      'Bespoke ceiling, lighting, and floor plans',
      'Sourcing of curtains, lighting fixtures, and decor',
    ],
    slug: 'interior-design',
    image: service1,
    stats: '120+ Projects',
  },
  {
    icon: 'mdi:hammer-wrench',
    title: 'Renovation & Remodeling',
    desc: 'Transform your existing house or office into a premium, modern space. Our team handles everything from minor cosmetic upgrades to full structural renovations.',
    details: [
      'Full home, bathroom, and kitchen remodeling',
      'Structural layout and re-partitioning',
      'Plumbing, electrical, and wiring upgrades',
      'High-end paint, tile, and flooring installation',
    ],
    slug: 'renovation',
    image: service2,
    stats: '80+ Renovations',
  },
  {
    icon: 'mdi:sofa-single',
    title: 'Furniture & Custom Fitout',
    desc: 'Maximize space and aesthetics with custom millwork and cabinetry. Our craftspeople build fitted furniture designed to last.',
    details: [
      'Bespoke built-in wardrobes and cabinets',
      'Custom modular kitchen cabinets and islands',
      'Workspace and media console fitting',
      'Premium wood and hardware selection',
    ],
    slug: 'furniture-consultation',
    image: service3,
    stats: '50+ Custom Builds',
  },
];

const processes = [
  {
    step: '01',
    title: 'Consultation',
    desc: 'We understand your goals, budget, aesthetic, and how you use the space day to day.',
  },
  {
    step: '02',
    title: 'Concept Design',
    desc: 'Layouts, 3D visuals, and material selections prepared for your review and feedback.',
  },
  {
    step: '03',
    title: 'Construction',
    desc: 'Skilled builders execute the design with precision and clear progress updates.',
  },
  {
    step: '04',
    title: 'Handover',
    desc: 'Quality walkthrough, site cleanup, and a space ready for you to move in.',
  },
];
---

<Layout
  title="Our Services | BuildPRO"
  description="Discover our premium Interior Design, Renovation, and Custom Furniture services tailored to bring your vision to life."
  navVariant="solid"
>
  <main id="main-content" class="min-h-screen bg-white pt-24 font-poppins">
    <section class="relative overflow-hidden bg-gray-950 px-5 py-16 text-white sm:px-6 md:px-12 lg:px-24">
      <div class="pointer-events-none absolute -right-16 top-0 h-72 w-72 rounded-full bg-amber-400/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-4xl">
        <nav class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">
          <a href="/" class="transition hover:text-white">Home</a>
          <span class="text-white/30">/</span>
          <span class="text-white/60">Services</span>
        </nav>
        <h1 class="text-4xl font-bold leading-tight md:text-5xl">Our Services & Solutions</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-gray-400 md:text-base">
          From kitchen refreshes to full commercial fitouts — end-to-end interior design and construction, shaped around your needs.
        </p>
      </div>
    </section>

    <section class="section-pad container-site flex flex-col gap-20 lg:gap-28">
      {services.map((service, index) => {
        const isEven = index % 2 === 0;

        return (
          <article
            id={service.slug}
            class:list={[
              'scroll-mt-28 flex flex-col items-center gap-10 lg:gap-16',
              isEven ? 'lg:flex-row' : 'lg:flex-row-reverse',
            ]}
          >
            <div class="w-full lg:w-1/2">
              <div class="group relative overflow-hidden rounded-3xl shadow-xl ring-1 ring-gray-100">
                <img
                  src={service.image.src}
                  alt={service.title}
                  loading="lazy"
                  class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                <span class="absolute left-5 top-5 rounded-full bg-white/95 px-4 py-2 text-xs font-semibold text-gray-800">
                  {service.stats}
                </span>
              </div>
            </div>

            <div class="flex w-full flex-col gap-6 lg:w-1/2">
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100 text-amber-500">
                  <Icon name={service.icon} size={28} />
                </div>
                <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{service.title}</h2>
              </div>

              <p class="leading-relaxed text-gray-500">{service.desc}</p>

              <ul class="flex flex-col gap-3">
                {service.details.map((detail) => (
                  <li class="flex items-start gap-3 text-sm text-gray-700">
                    <Icon name="mdi:check-circle" size={20} class="mt-0.5 shrink-0 text-amber-400" />
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>

              <a
                href="/#contact"
                class="group inline-flex w-fit items-center gap-2 rounded-2xl bg-gray-900 px-7 py-4 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-amber-400 hover:text-gray-900"
              >
                Inquire this service
                <Icon name="mdi:arrow-right" size={18} class="text-current transition group-hover:translate-x-0.5" />
              </a>
            </div>
          </article>
        );
      })}
    </section>

    <section class="bg-[#fafafa] section-pad">
      <div class="container-site">
        <div class="mx-auto mb-14 max-w-2xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-amber-500">Workflow</p>
          <h2 class="mt-3 text-3xl font-bold text-gray-900 md:text-4xl">Our Working Process</h2>
          <p class="mt-4 text-sm leading-relaxed text-gray-500 md:text-base">
            How we move your project from first conversation to finished space.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {processes.map((proc) => (
            <div class="relative overflow-hidden rounded-3xl border border-gray-100 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-amber-200/50 hover:shadow-lg">
              <span class="absolute right-5 top-4 text-5xl font-black text-amber-400/20">{proc.step}</span>
              <h3 class="relative text-lg font-bold text-gray-900">{proc.title}</h3>
              <p class="relative mt-3 text-sm leading-relaxed text-gray-500">{proc.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad bg-amber-400">
      <div class="container-site mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold text-gray-900 md:text-4xl">Ready to build your next dream space?</h2>
        <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-gray-900/80 md:text-base">
          Talk with the BuildPRO team for a free project assessment and consultation with our designers.
        </p>
        <a
          href="/#contact"
          class="group mt-8 inline-flex items-center gap-2 rounded-2xl bg-gray-900 px-8 py-4 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-gray-800"
        >
          Contact our team
          <Icon name="mdi:arrow-right" size={18} class="text-current transition group-hover:translate-x-0.5" />
        </a>
      </div>
    </section>
  </main>
</Layout>
