---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/server/adminAuth';
import { getCsrfToken } from '../../../lib/server/csrf';
import { getSupabaseAdmin, hasSupabaseConfig } from '../../../lib/server/supabaseAdmin';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

let blogs = [];
let error = '';
const csrfToken = getCsrfToken(Astro);

if (hasSupabaseConfig()) {
  const supabase = getSupabaseAdmin();
  const result = await supabase
    .from('blogs')
    .select('id,title,slug,published,created_at,image_url')
    .order('created_at', { ascending: false });

  blogs = result.data || [];
  error = result.error?.message || '';
} else {
  error = 'Supabase belum dikonfigurasi. Isi .env dari .env.example.';
}
---

<AdminLayout title="Blogs Admin | BuildPRO">
  <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Blogs</p>
      <h1 class="mt-2 text-3xl font-bold">Daftar Blog</h1>
    </div>
    <a href="/admin/blogs/new" class="bg-gray-900 px-5 py-3 text-sm font-semibold text-white hover:bg-amber-500 hover:text-gray-900">
      Tambah Blog
    </a>
  </div>

  {error && <div class="mb-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <div class="hidden overflow-hidden border border-gray-200 bg-white shadow-sm md:block">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-5 py-4">Title</th>
          <th class="px-5 py-4">Slug</th>
          <th class="px-5 py-4">Status</th>
          <th class="px-5 py-4">Created</th>
          <th class="px-5 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {blogs.length === 0 ? (
          <tr>
            <td colspan="5" class="px-5 py-8 text-center text-gray-500">Belum ada blog.</td>
          </tr>
        ) : blogs.map((blog) => (
          <tr>
            <td class="px-5 py-4 font-medium">{blog.title}</td>
            <td class="px-5 py-4 text-gray-500">{blog.slug}</td>
            <td class="px-5 py-4">
              <span class:list={[
                'px-2.5 py-1 text-xs font-semibold uppercase',
                blog.published ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-500'
              ]}>
                {blog.published ? 'Published' : 'Draft'}
              </span>
            </td>
            <td class="px-5 py-4 text-gray-500">{new Date(blog.created_at).toLocaleDateString('id-ID')}</td>
            <td class="px-5 py-4">
              <div class="flex justify-end gap-2">
                <a href={`/admin/blogs/${blog.id}/edit`} class="border border-gray-300 px-3 py-2 text-xs font-semibold hover:border-amber-400 hover:text-amber-500">Edit</a>
                <form method="post" action={`/admin/blogs/${blog.id}/delete`} onsubmit="return confirm('Hapus blog ini?')">
                  <input type="hidden" name="_csrf" value={csrfToken} />
                  <button class="border border-red-200 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="grid gap-4 md:hidden">
    {blogs.length === 0 ? (
      <div class="border border-gray-200 bg-white px-5 py-8 text-center text-sm text-gray-500">Belum ada blog.</div>
    ) : blogs.map((blog) => (
      <article class="border border-gray-200 bg-white p-4 shadow-sm">
        {blog.image_url && <img src={blog.image_url} alt={blog.title} class="mb-4 aspect-video w-full object-cover" />}
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="font-semibold">{blog.title}</h2>
            <p class="mt-1 break-all text-xs text-gray-400">{blog.slug}</p>
          </div>
          <span class:list={[
            'shrink-0 px-2.5 py-1 text-[11px] font-semibold uppercase',
            blog.published ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-500'
          ]}>
            {blog.published ? 'Published' : 'Draft'}
          </span>
        </div>
        <p class="mt-3 text-xs text-gray-500">{new Date(blog.created_at).toLocaleDateString('id-ID')}</p>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <a href={`/admin/blogs/${blog.id}/edit`} class="border border-gray-300 px-3 py-2 text-center text-xs font-semibold hover:border-amber-400 hover:text-amber-500">Edit</a>
          <form method="post" action={`/admin/blogs/${blog.id}/delete`} onsubmit="return confirm('Hapus blog ini?')">
            <input type="hidden" name="_csrf" value={csrfToken} />
            <button class="w-full border border-red-200 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Delete</button>
          </form>
        </div>
      </article>
    ))}
  </div>
</AdminLayout>
