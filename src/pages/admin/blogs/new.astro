---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/server/adminAuth';
import { getCsrfToken, validateCsrf } from '../../../lib/server/csrf';
import { getSupabaseAdmin } from '../../../lib/server/supabaseAdmin';
import { uploadImageFile } from '../../../lib/server/adminContent';
import { parseTags, toSlug } from '../../../lib/server/slug';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

let error = '';
const csrfToken = getCsrfToken(Astro);

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = String(formData.get('title') || '').trim();
  const slug = toSlug(formData.get('slug') || title);
  const excerpt = String(formData.get('excerpt') || '').trim();
  const content = String(formData.get('content') || '').trim();
  let image_url = String(formData.get('image_url') || '').trim();
  const author = String(formData.get('author') || 'BuildPRO Team').trim();
  const tags = parseTags(formData.get('tags'));
  const published = formData.get('published') === 'on';

  if (!validateCsrf(Astro, formData)) {
    error = 'Sesi form tidak valid. Muat ulang halaman lalu coba lagi.';
  } else if (!title || !slug || !content) {
    error = 'Title, slug, dan content wajib diisi.';
  } else {
    const supabase = getSupabaseAdmin();
    try {
      const uploadedImage = await uploadImageFile(supabase, formData.get('image_file'), 'blogs');
      image_url = uploadedImage || image_url;

      const result = await supabase.from('blogs').insert({
        title,
        slug,
        excerpt,
        content,
        image_url,
        author,
        tags,
        published,
      });

      if (result.error) {
        error = result.error.message;
      } else {
        return Astro.redirect('/admin/blogs');
      }
    } catch (uploadError) {
      error = uploadError.message;
    }
  }
}
---

<AdminLayout title="Tambah Blog | BuildPRO">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Blogs</p>
    <h1 class="mt-2 text-3xl font-bold">Tambah Blog</h1>
  </div>

  {error && <div class="mb-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <form method="post" enctype="multipart/form-data" class="grid gap-5 border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
    <input type="hidden" name="_csrf" value={csrfToken} />
    <div class="grid gap-5 md:grid-cols-2">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Title</span>
        <input name="title" required class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Slug</span>
        <input name="slug" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" placeholder="otomatis dari title jika kosong" />
      </label>
    </div>

    <label class="block">
      <span class="mb-2 block text-sm font-medium">Excerpt</span>
      <textarea name="excerpt" rows="3" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400"></textarea>
    </label>

    <label class="block">
      <span class="mb-2 block text-sm font-medium">Content</span>
      <textarea name="content" rows="12" required class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400"></textarea>
    </label>

    <div class="grid gap-5 md:grid-cols-3">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Image URL</span>
        <input name="image_url" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Upload Foto</span>
        <input name="image_file" type="file" accept="image/*" class="w-full border border-gray-300 bg-white px-4 py-2.5 text-sm outline-none file:mr-3 file:border-0 file:bg-gray-900 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Author</span>
        <input name="author" value="BuildPRO Team" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Tags</span>
        <input name="tags" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" placeholder="design, renovation" />
      </label>
    </div>

    <label class="flex items-center gap-3 text-sm font-medium">
      <input type="checkbox" name="published" class="h-4 w-4 accent-amber-400" />
      Published
    </label>

    <div class="grid gap-3 sm:flex">
      <button type="submit" class="bg-gray-900 px-5 py-3 text-sm font-semibold text-white hover:bg-amber-500 hover:text-gray-900">Simpan Blog</button>
      <a href="/admin/blogs" class="border border-gray-300 px-5 py-3 text-center text-sm font-semibold text-gray-700 hover:border-gray-900">Batal</a>
    </div>
  </form>
</AdminLayout>
