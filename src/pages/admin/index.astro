---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/server/adminAuth';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;
---

<AdminLayout title="Dashboard Admin | BuildPRO">
  <section class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Dashboard</p>
    <h1 class="mt-2 text-3xl font-bold">Kelola Konten Website</h1>
    <p class="mt-2 max-w-2xl text-sm text-gray-500">
      Gunakan area ini untuk menambahkan blog dan project baru ke database Supabase.
    </p>
  </section>

  <div class="grid gap-6 md:grid-cols-2">
    <a href="/admin/blogs" class="border border-gray-200 bg-white p-6 shadow-sm transition hover:border-amber-400">
      <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">Content</p>
      <h2 class="mt-3 text-2xl font-bold">Blogs</h2>
      <p class="mt-2 text-sm text-gray-500">Lihat dan tambah artikel blog.</p>
    </a>

    <a href="/admin/projects" class="border border-gray-200 bg-white p-6 shadow-sm transition hover:border-amber-400">
      <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">Portfolio</p>
      <h2 class="mt-3 text-2xl font-bold">Projects</h2>
      <p class="mt-2 text-sm text-gray-500">Lihat dan tambah project portfolio.</p>
    </a>
  </div>
</AdminLayout>
