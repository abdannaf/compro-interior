---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../lib/server/adminAuth';
import { getCsrfToken, validateCsrf } from '../../../../lib/server/csrf';
import { deleteImageByUrl, uploadImageFile } from '../../../../lib/server/adminContent';
import { getSupabaseAdmin } from '../../../../lib/server/supabaseAdmin';
import { toSlug } from '../../../../lib/server/slug';

const redirect = await requireAdmin(Astro);
if (redirect) return redirect;

const supabase = getSupabaseAdmin();
const id = Astro.params.id;
let error = '';
const csrfToken = getCsrfToken(Astro);

const { data: existingProject, error: fetchError } = await supabase
  .from('projects')
  .select('*')
  .eq('id', id)
  .maybeSingle();

let project = existingProject;

if (fetchError || !project) {
  return Astro.redirect('/admin/projects');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = String(formData.get('title') || '').trim();
  const slug = toSlug(formData.get('slug') || title);
  const location = String(formData.get('location') || '').trim();
  const category = String(formData.get('category') || '').trim();
  const client = String(formData.get('client') || '').trim();
  const year = String(formData.get('year') || '').trim();
  const excerpt = String(formData.get('excerpt') || '').trim();
  const content = String(formData.get('content') || '').trim();
  let image_url = String(formData.get('image_url') || '').trim();
  const published = formData.get('published') === 'on';

  if (!validateCsrf(Astro, formData)) {
    error = 'Sesi form tidak valid. Muat ulang halaman lalu coba lagi.';
  } else if (!title || !slug || !content) {
    error = 'Title, slug, dan content wajib diisi.';
  } else {
    try {
      const uploadedImage = await uploadImageFile(supabase, formData.get('image_file'), 'projects');
      image_url = uploadedImage || image_url;

      const result = await supabase
        .from('projects')
        .update({
          title,
          slug,
          location,
          category,
          client,
          year,
          excerpt,
          content,
          image_url,
          published,
          updated_at: new Date().toISOString(),
        })
        .eq('id', id);

      if (result.error) {
        error = result.error.message;
      } else {
        if (uploadedImage && project.image_url && project.image_url !== uploadedImage) {
          await deleteImageByUrl(supabase, project.image_url);
        }
        return Astro.redirect('/admin/projects');
      }
    } catch (uploadError) {
      error = uploadError.message;
    }
  }
}
---

<AdminLayout title="Edit Project | BuildPRO">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Projects</p>
    <h1 class="mt-2 text-3xl font-bold">Edit Project</h1>
  </div>

  {error && <div class="mb-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>}

  <form method="post" enctype="multipart/form-data" class="grid gap-5 border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
    <input type="hidden" name="_csrf" value={csrfToken} />
    {project.image_url && (
      <div>
        <span class="mb-2 block text-sm font-medium">Foto Saat Ini</span>
        <img src={project.image_url} alt={project.title} class="aspect-video w-full max-w-xl object-cover" />
      </div>
    )}

    <div class="grid gap-5 md:grid-cols-2">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Title</span>
        <input name="title" value={project.title} required class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Slug</span>
        <input name="slug" value={project.slug} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Location</span>
        <input name="location" value={project.location} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Category</span>
        <input name="category" value={project.category} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Client</span>
        <input name="client" value={project.client} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Year</span>
        <input name="year" value={project.year} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
    </div>

    <label class="block">
      <span class="mb-2 block text-sm font-medium">Excerpt</span>
      <textarea name="excerpt" rows="3" class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400">{project.excerpt}</textarea>
    </label>

    <label class="block">
      <span class="mb-2 block text-sm font-medium">Content</span>
      <textarea name="content" rows="12" required class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400">{project.content}</textarea>
    </label>

    <div class="grid gap-5 md:grid-cols-2">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Image URL</span>
        <input name="image_url" value={project.image_url} class="w-full border border-gray-300 px-4 py-3 text-sm outline-none focus:border-amber-400" />
      </label>
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Upload Foto Baru</span>
        <input name="image_file" type="file" accept="image/*" class="w-full border border-gray-300 bg-white px-4 py-2.5 text-sm outline-none file:mr-3 file:border-0 file:bg-gray-900 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white focus:border-amber-400" />
      </label>
    </div>

    <label class="flex items-center gap-3 text-sm font-medium">
      <input type="checkbox" name="published" checked={project.published} class="h-4 w-4 accent-amber-400" />
      Published
    </label>

    <div class="grid gap-3 sm:flex">
      <button type="submit" class="bg-gray-900 px-5 py-3 text-sm font-semibold text-white hover:bg-amber-500 hover:text-gray-900">Update Project</button>
      <a href="/admin/projects" class="border border-gray-300 px-5 py-3 text-center text-sm font-semibold text-gray-700 hover:border-gray-900">Batal</a>
    </div>
  </form>
</AdminLayout>
