---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Admin | BuildPRO' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="font-poppins bg-slate-100 text-gray-900">
    <div class="min-h-screen">
      <header class="sticky top-0 z-30 border-b border-gray-200 bg-white/95 backdrop-blur">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 sm:px-6 md:flex-row md:items-center md:justify-between">
          <a href="/admin" class="text-xl font-bold leading-none">
            Build<span class="text-amber-400">PRO</span> Admin
          </a>
          <nav class="-mx-1 flex max-w-full items-center gap-2 overflow-x-auto text-sm font-medium text-gray-600 sm:gap-3">
            <a href="/admin/blogs" class="shrink-0 rounded-xl border border-gray-200 px-3 py-2 transition hover:border-amber-400 hover:text-amber-500">Blogs</a>
            <a href="/admin/projects" class="shrink-0 rounded-xl border border-gray-200 px-3 py-2 transition hover:border-amber-400 hover:text-amber-500">Projects</a>
            <a href="/" class="shrink-0 rounded-xl border border-gray-200 px-3 py-2 transition hover:border-amber-400 hover:text-amber-500">Website</a>
            <a href="/admin/logout" class="shrink-0 rounded-xl border border-red-100 px-3 py-2 text-red-500 transition hover:border-red-300 hover:bg-red-50 hover:text-red-600">Logout</a>
          </nav>
        </div>
      </header>
      <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
        <slot />
      </main>
    </div>
  </body>
</html>
