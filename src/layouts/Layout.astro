---
import Footer from "../components/Footer/Footer.jsx"
import Navbar from "../components/Navbar/Navbar.jsx"
import '../styles/global.css'

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	canonicalPath?: string;
	preloadImage?: string;
	navVariant?: 'transparent' | 'solid';
}

const {
	title = "BuildPRO - Professional Interior Design & Construction Services",
	description = "BuildPRO is a portfolio-ready interior design and construction website with admin-managed blog and project content.",
	ogTitle = "BuildPRO - Professional Interior Design & Construction",
	ogDescription = "A responsive Astro, React, Tailwind, and Supabase company profile demo for an interior studio.",
	canonicalPath = Astro.url.pathname,
	preloadImage,
	navVariant = 'solid',
} = Astro.props;

const siteUrl = 'https://buildpro-demo.local';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'HomeAndConstructionBusiness',
	name: 'BuildPRO Interior Studio',
	url: siteUrl,
	description,
	areaServed: 'Indonesia',
	serviceType: ['Interior Design', 'Renovation', 'Custom Furniture'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="keywords" content="interior design, construction, renovation, contractor, home design, BuildPRO" />
		<meta name="author" content="BuildPRO" />
		<link rel="canonical" href={canonicalUrl} />
		{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="BuildPRO" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<title>{title}</title>
	</head>
	<body class="font-poppins">
		<Navbar client:load variant={navVariant} currentPath={Astro.url.pathname} />
		<main id="main-content">
			<slot />
		</main>
		<Footer client:visible />
	</body>
</html>
